# Modelo das variáveis de ambiente. NÃO coloque valores reais aqui.
# Para rodar o projeto: copie este arquivo para ".env.local" e preencha os valores
# (painel do Supabase → Project Settings → API). O .env.local nunca vai para o Git.

# Endereço do projeto no Supabase (pode ficar visível no navegador)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon/publishable) — pode ficar visível no navegador; a RLS protege os dados
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA (service_role). Passa por cima de toda a segurança do banco.
# Só é usada no servidor (src/lib/supabase/admin.ts). Nunca compartilhe nem use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço do app, usado nos links de convite (ex.: http://localhost:3000 no computador)
APP_URL=
